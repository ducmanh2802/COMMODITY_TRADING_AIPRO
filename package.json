{
  "name": "commodity-trading-aipro",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "start": "tsx server.ts --production",
    "preview": "vite preview",
    "clean": "node -e \"for (const p of ['dist','server.js']) require('node:fs').rmSync(p, { recursive: true, force: true })\"",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"server/**/*.test.ts\" \"src/**/*.test.ts\" \"*.test.ts\"",
    "test:rules": "npx -y firebase-tools@13.35.1 emulators:exec --only firestore --project demo-commodity-aipro \"tsx --test tests/rules/*.test.ts\"",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@google/genai": "^3.4.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^13.4.0",
    "lightweight-charts": "^5.3.0",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tsx": "^4.21.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.21",
    "eslint": "^10.15.0",
    "firebase-tools": "^13.35.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
