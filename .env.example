# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
# GEMINI_MODEL (optional): model or comma-separated fallback list. Default = free tier:
#   gemini-flash-lite-latest, gemini-3.5-flash-lite, gemini-3.1-flash-lite, gemma-4-* (tries the next one on 503/429/404)
# GEMINI_MODEL="gemini-flash-lite-latest,gemini-3.5-flash-lite"
# OPENROUTER_API_KEY (optional, free at https://openrouter.ai/keys): last fallback using OpenRouter ":free" models
# OPENROUTER_API_KEY=""
# OPENROUTER_MODEL (optional): comma list of OpenRouter model ids; default = live list of ":free" models

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional Server-Side Market Data & Macro API Keys (never expose to client):
# Twelve Data (Real-time & Intraday OHLCV + USD/VND FX):
# TWELVEDATA_API_KEY=""
# Financial Modeling Prep (Commodity Futures/Spot Quotes & EOD OHLCV):
# FMP_API_KEY=""
# Commodities-API (Real-time Spot & Futures Rates):
# COMMODITIES_API_KEY=""
# Alpha Vantage (Commodities Daily Spot/Ref & USD/VND FX):
# ALPHAVANTAGE_API_KEY=""
# U.S. EIA Open Data v2 (Crude Oil & Natural Gas Inventories & Spot/Futures; also weekly fuel-ethanol production):
# EIA_API_KEY=""
# USDA FAS Export Sales Reporting (weekly U.S. corn/soybean/wheat shipments; free key via api.data.gov):
# FAS_API_KEY=""
# USDA NASS QuickStats (Agricultural Crop Production & Stocks):
# USDA_API_KEY=""
# Federal Reserve Economic Data (DXY Broad USD, Fed Funds Rate, US 10Y Yield, CPI):
# FRED_API_KEY=""
# Authorized Exchange / Member Feeds (MXV via CQG/Member Webservice):
# MXV_API_KEY=""
# MXV_API_URL=""
# CME_DATAMINE_API_KEY=""
# ICE_API_KEY=""
# MARKET_DATA_PROVIDER_URL=""
# MARKET_DATA_PROVIDER_KEY=""

# Yahoo Finance delayed quotes (UNOFFICIAL, free, no account) — default OFF.
# Set to "true" to fetch continuous front-month quotes (ZC=F, CL=F, ...) server-side from the public
# Yahoo chart endpoint, lowest priority after licensed/official feeds. Delays: CBOT ~10 min,
# ICE US / COMEX / NYMEX ~30 min. Yahoo's terms permit PERSONAL USE ONLY: do not redistribute or
# display this data publicly or commercially. No RC (Robusta), ICE Brent, TIO or JRU coverage.
# YAHOO_ENABLED="false"

# Admin token for mutating endpoints (data import/delete, COT sync, provider sync, legacy CSV
# import/clear, macro records). Clients send "Authorization: Bearer <token>". When unset, these
# endpoints accept ONLY direct localhost requests. Use a long random value (>= 16 chars).
# ADMIN_API_TOKEN=""
# SQLite file for the historical data layer (default data/market.db).
# MARKET_DB_PATH=""

# COT (CFTC Commitments of Traders) source:
#   auto    = Socrata API (publicreporting.cftc.gov) first, CFTC historical zip files on failure (default)
#   socrata = Socrata API only
#   files   = CFTC historical zip files only (www.cftc.gov/files/dea/history)
# COT_SOURCE="auto"
# Cache directory for downloaded CFTC zip files (default data/cache/cftc; verified by SHA-256 on reuse).
# COT_CACHE_DIR=""

# Server-side periodic sync (COT weekly + startup catch-up, VCB FX, WASDE, EIA/FRED when keys exist).
# Status: GET /api/scheduler/status. Set to false to disable. Never runs in tests.
# SCHEDULER_ENABLED="true"

# Scorecard narrative engine: rules (default, free, offline) | gemini | ollama.
#   rules  = templates built from the scorecard numbers, no key, no network
#   gemini = uses GEMINI_API_KEY (a free-tier key from Google AI Studio works)
#   ollama = local model via OLLAMA_URL; falls back to rules if unreachable
# AI_PROVIDER="rules"
# OLLAMA_URL="http://localhost:11434"
# OLLAMA_MODEL="llama3.2"

# Optional Telegram notifications (watchlist price-zone alerts + Radar events). Off when empty.
# Create a bot with @BotFather and put its token here. Users link a chat with /start <code> (code shown in the Watchlist panel).
# Messages use delayed/closing prices and are informational, never advice. The token is never logged.
# TELEGRAM_BOT_TOKEN=""
# Optional admin alert: numeric private chat id that receives ONE message when a data source is stale for > 2x its update cadence
# (repeated only after it recovers). Needs TELEGRAM_BOT_TOKEN and SCHEDULER_ENABLED. Off when empty.
# TELEGRAM_ADMIN_CHAT_ID=""

# Optional durable backup of the SQLite market DB to Google Cloud Storage (T53). Off when GCS_BACKUP_BUCKET is empty.
# Credentials come from the runtime service account (Cloud Run) or GOOGLE_APPLICATION_CREDENTIALS; needs Storage Object Admin on the bucket.
# GCS_BACKUP_BUCKET=""
# GCS_BACKUP_KEEP="14"
# GCS_BACKUP_INTERVAL_HOURS="6"

# T101 optional Web Push (browser notifications). Off when empty. Generate keys: npx web-push generate-vapid-keys
# Keys are read from env only and never logged.
# VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""
# VAPID_SUBJECT="mailto:you@example.com"

# T101 optional email alerts (double opt-in, <= 20 emails/day per address). Off unless SMTP_HOST, SMTP_FROM and APP_BASE_URL are set.
# APP_BASE_URL is the public origin used in confirm/unsubscribe links, e.g. https://app.example.com
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM="Commodity Trading AI Pro <noreply@example.com>"
# APP_BASE_URL=""
