rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 1 / Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Reusable hardened primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isVerifiedOwner(ownerId) {
      return isVerifiedUser() && request.auth.uid == ownerId;
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'createdAt', 'updatedAt'])
        && data.uid is string
        && data.uid.size() >= 1
        && data.uid.size() <= 128
        && data.uid == userId
        && data.uid == request.auth.uid
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 254
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 120
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserSettings(data, userId) {
      return data.keys().hasAll([
        'userId',
        'accountEquity',
        'accountCurrency',
        'riskPercentagePerTrade',
        'dailyLossLimitPct',
        'maxOpenPositions',
        'maxPortfolioRiskPct',
        'maxContractsPerInstrument',
        'defaultTradingStyle',
        'defaultTimeframe',
        'displayTimezone',
        'createdAt',
        'updatedAt'
      ])
        && data.keys().hasOnly([
        'userId',
        'accountEquity',
        'accountCurrency',
        'riskPercentagePerTrade',
        'dailyLossLimitPct',
        'maxOpenPositions',
        'maxPortfolioRiskPct',
        'maxContractsPerInstrument',
        'defaultTradingStyle',
        'defaultTimeframe',
        'displayTimezone',
        'createdAt',
        'updatedAt'
      ])
        && data.userId is string
        && data.userId.size() >= 1
        && data.userId.size() <= 128
        && data.userId == userId
        && data.userId == request.auth.uid
        && data.accountEquity is number
        && data.accountEquity >= 0
        && data.accountEquity <= 1000000000000
        && data.accountCurrency is string
        && data.accountCurrency.size() >= 3
        && data.accountCurrency.size() <= 8
        && data.accountCurrency in ['USD', 'VND']
        && data.riskPercentagePerTrade is number
        && data.riskPercentagePerTrade >= 0.05
        && data.riskPercentagePerTrade <= 10
        && data.dailyLossLimitPct is number
        && data.dailyLossLimitPct >= 0.5
        && data.dailyLossLimitPct <= 25
        && data.maxOpenPositions is int
        && data.maxOpenPositions >= 1
        && data.maxOpenPositions <= 50
        && data.maxPortfolioRiskPct is number
        && data.maxPortfolioRiskPct >= 0.5
        && data.maxPortfolioRiskPct <= 50
        && data.maxContractsPerInstrument is int
        && data.maxContractsPerInstrument >= 1
        && data.maxContractsPerInstrument <= 100
        && data.defaultTradingStyle is string
        && data.defaultTradingStyle.size() <= 16
        && data.defaultTradingStyle in ['SCALPING', 'INTRADAY', 'SWING', 'POSITION']
        && data.defaultTimeframe is string
        && data.defaultTimeframe.size() <= 8
        && data.defaultTimeframe in ['M1', 'M5', 'M15', 'M30', 'H1', 'H4', 'D1', 'W1']
        && data.displayTimezone is string
        && data.displayTimezone.size() <= 32
        && data.displayTimezone in ['Asia/Ho_Chi_Minh', 'UTC', 'America/Chicago', 'Europe/London']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPortfolioPosition(data) {
      return data.keys().hasAll([
        'userId',
        'instrumentId',
        'productName',
        'category',
        'exchange',
        'direction',
        'contracts',
        'entryPrice',
        'stopLoss',
        'takeProfit',
        'estimatedMargin',
        'marginVerified',
        'status',
        'notes',
        'createdAt',
        'updatedAt'
      ])
        && data.keys().hasOnly([
        'userId',
        'instrumentId',
        'productName',
        'category',
        'exchange',
        'direction',
        'contracts',
        'entryPrice',
        'stopLoss',
        'takeProfit',
        'estimatedMargin',
        'marginVerified',
        'status',
        'notes',
        'createdAt',
        'updatedAt'
      ])
        && data.userId is string
        && data.userId.size() >= 1
        && data.userId.size() <= 128
        && data.userId == request.auth.uid
        && data.instrumentId is string
        && data.instrumentId.size() >= 1
        && data.instrumentId.size() <= 32
        && data.productName is string
        && data.productName.size() >= 1
        && data.productName.size() <= 80
        && data.category is string
        && data.category.size() <= 24
        && data.category in ['AGRICULTURE', 'SOFT_COMMODITIES', 'METALS', 'ENERGY']
        && data.exchange is string
        && data.exchange.size() <= 16
        && data.exchange in ['MXV', 'CBOT', 'CME', 'COMEX', 'NYMEX', 'ICE']
        && data.direction is string
        && data.direction.size() <= 8
        && data.direction in ['LONG', 'SHORT']
        && data.contracts is int
        && data.contracts >= 1
        && data.contracts <= 1000
        && data.entryPrice is number
        && data.entryPrice > 0
        && data.stopLoss is number
        && data.stopLoss > 0
        && data.takeProfit is number
        && data.takeProfit > 0
        && data.estimatedMargin is number
        && data.estimatedMargin >= 0
        && data.marginVerified is bool
        && data.status is string
        && data.status.size() <= 12
        && data.status in ['OPEN', 'CLOSED']
        && data.notes is string
        && data.notes.size() <= 500
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTradeJournalEntry(data) {
      return data.keys().hasAll([
        'userId',
        'instrument',
        'exchange',
        'direction',
        'strategy',
        'timeframe',
        'entryPrice',
        'stopLoss',
        'takeProfit',
        'positionSize',
        'entryTimestamp',
        'exitTimestamp',
        'exitPrice',
        'realizedPnl',
        'tradingCosts',
        'resultInR',
        'rationale',
        'notes',
        'status',
        'createdAt',
        'updatedAt'
      ])
        && data.keys().hasOnly([
        'userId',
        'instrument',
        'exchange',
        'direction',
        'strategy',
        'timeframe',
        'entryPrice',
        'stopLoss',
        'takeProfit',
        'positionSize',
        'entryTimestamp',
        'exitTimestamp',
        'exitPrice',
        'realizedPnl',
        'tradingCosts',
        'resultInR',
        'rationale',
        'notes',
        'status',
        'createdAt',
        'updatedAt'
      ])
        && data.userId is string
        && data.userId.size() >= 1
        && data.userId.size() <= 128
        && data.userId == request.auth.uid
        && data.instrument is string
        && data.instrument.size() >= 1
        && data.instrument.size() <= 32
        && data.exchange is string
        && data.exchange.size() <= 16
        && data.exchange in ['MXV', 'CBOT', 'CME', 'COMEX', 'NYMEX', 'ICE']
        && data.direction is string
        && data.direction.size() <= 8
        && data.direction in ['LONG', 'SHORT']
        && data.strategy is string
        && data.strategy.size() >= 1
        && data.strategy.size() <= 64
        && data.timeframe is string
        && data.timeframe.size() <= 8
        && data.timeframe in ['M1', 'M5', 'M15', 'M30', 'H1', 'H4', 'D1', 'W1']
        && data.entryPrice is number
        && data.entryPrice > 0
        && data.stopLoss is number
        && data.stopLoss > 0
        && data.takeProfit is number
        && data.takeProfit > 0
        && data.positionSize is int
        && data.positionSize >= 1
        && data.positionSize <= 1000
        && data.entryTimestamp is string
        && data.entryTimestamp.size() >= 1
        && data.entryTimestamp.size() <= 64
        && data.exitTimestamp is string
        && data.exitTimestamp.size() <= 64
        && data.exitPrice is number
        && data.exitPrice >= 0
        && data.realizedPnl is number
        && data.tradingCosts is number
        && data.tradingCosts >= 0
        && data.resultInR is number
        && data.rationale is string
        && data.rationale.size() <= 1000
        && data.notes is string
        && data.notes.size() <= 1000
        && data.status is string
        && data.status.size() <= 12
        && data.status in ['OPEN', 'CLOSED']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll(['userId', 'action', 'resource', 'createdAt'])
        && data.keys().hasOnly(['userId', 'action', 'resource', 'createdAt'])
        && data.userId is string
        && data.userId.size() >= 1
        && data.userId.size() <= 128
        && data.userId == request.auth.uid
        && data.action is string
        && data.action.size() >= 1
        && data.action.size() <= 80
        && data.resource is string
        && data.resource.size() >= 1
        && data.resource.size() <= 120
        && data.createdAt is timestamp;
    }

    // Research Notebook (T18). Limits mirror NOTE_LIMITS in src/components/views/journal/researchNotes.ts.
    function isValidNoteTagAt(tags, i) {
      return tags.size() <= i || (tags[i] is string && tags[i].size() >= 1 && tags[i].size() <= 32);
    }

    function isValidNoteChartContext(ctx) {
      return ctx is map
        && ctx.keys().hasAll(['timeframe', 'contractCode', 'rangeStart', 'rangeEnd'])
        && ctx.keys().hasOnly(['timeframe', 'contractCode', 'rangeStart', 'rangeEnd'])
        && ctx.timeframe is string
        && (ctx.timeframe == '' || ctx.timeframe in ['M1', 'M5', 'M15', 'M30', 'H1', 'H4', 'D1', 'W1'])
        && ctx.contractCode is string
        && ctx.contractCode.size() <= 24
        && ctx.rangeStart is string
        && ctx.rangeStart.size() <= 40
        && ctx.rangeEnd is string
        && ctx.rangeEnd.size() <= 40;
    }

    function isValidResearchNote(data) {
      return data.keys().hasAll(['userId', 'instrumentId', 'title', 'body', 'tags', 'chartContext', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'instrumentId', 'title', 'body', 'tags', 'chartContext', 'createdAt', 'updatedAt'])
        && data.userId is string
        && data.userId.size() >= 1
        && data.userId.size() <= 128
        && data.userId == request.auth.uid
        && data.instrumentId is string
        && data.instrumentId.size() >= 1
        && data.instrumentId.size() <= 32
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 120
        && data.body is string
        && data.body.size() <= 10000
        && data.tags is list
        && data.tags.size() <= 8
        && isValidNoteTagAt(data.tags, 0)
        && isValidNoteTagAt(data.tags, 1)
        && isValidNoteTagAt(data.tags, 2)
        && isValidNoteTagAt(data.tags, 3)
        && isValidNoteTagAt(data.tags, 4)
        && isValidNoteTagAt(data.tags, 5)
        && isValidNoteTagAt(data.tags, 6)
        && isValidNoteTagAt(data.tags, 7)
        && (data.chartContext == null || isValidNoteChartContext(data.chartContext))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Paper trading (T58, learning only). Limits mirror PAPER_LIMITS in src/components/views/papertrade/paperModel.ts.
    function isValidPaperSettings(s) {
      return s is map
        && s.keys().hasAll(['marginPct', 'feePerContractUsd', 'slippageTicks', 'marginCallPct', 'stopOutPct'])
        && s.keys().hasOnly(['marginPct', 'feePerContractUsd', 'slippageTicks', 'marginCallPct', 'stopOutPct'])
        && s.marginPct is number && s.marginPct >= 0 && s.marginPct <= 100
        && s.feePerContractUsd is number && s.feePerContractUsd >= 0 && s.feePerContractUsd <= 1000
        && s.slippageTicks is number && s.slippageTicks >= 0 && s.slippageTicks <= 100
        && s.marginCallPct is number && s.marginCallPct >= 0 && s.marginCallPct <= 1000
        && s.stopOutPct is number && s.stopOutPct >= 0 && s.stopOutPct <= 1000;
    }

    // A practice session ("Phiên giao dịch thử"): active (closedAt/finalEquityVnd null) or closed (both set).
    function isValidPaperSession(data) {
      return data.keys().hasAll(['userId', 'name', 'startingCapitalVnd', 'balanceVnd', 'settings', 'status', 'createdAt', 'updatedAt', 'closedAt', 'finalEquityVnd'])
        && data.keys().hasOnly(['userId', 'name', 'startingCapitalVnd', 'balanceVnd', 'settings', 'status', 'createdAt', 'updatedAt', 'closedAt', 'finalEquityVnd'])
        && data.userId is string
        && data.userId == request.auth.uid
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 80
        && data.startingCapitalVnd is number
        && data.startingCapitalVnd >= 1000000
        && data.startingCapitalVnd <= 1000000000000
        && data.balanceVnd is number
        && data.balanceVnd >= -1000000000000
        && data.balanceVnd <= 1000000000000000
        && isValidPaperSettings(data.settings)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && ((data.status == 'active' && data.closedAt == null && data.finalEquityVnd == null)
          || (data.status == 'closed' && data.closedAt is timestamp && data.finalEquityVnd is number));
    }

    // Children (positions / closed trades) must belong to a session of the same owner. getAfter() so a
    // batch may create the session and its children together (e.g. importing a local session).
    function paperSessionAfter(sessionId) {
      return getAfter(/databases/$(database)/documents/paperSessions/$(sessionId)).data;
    }

    function ownsPaperSession(sessionId) {
      return isValidId(sessionId)
        && existsAfter(/databases/$(database)/documents/paperSessions/$(sessionId))
        && paperSessionAfter(sessionId).userId == request.auth.uid;
    }

    function isValidPaperPrice(v) {
      return v is number && v > 0 && v <= 100000000;
    }

    function isValidPaperStop(v) {
      return v == null || isValidPaperPrice(v);
    }

    // Pre-trade checklist plan (optional on paper positions/orders). Must be a map with known fields only.
    function isValidPaperPlan(plan) {
      return plan is map
        && plan.size() <= 12
        && plan.keys().hasOnly(['answers', 'eventsOk', 'r', 'riskPct', 'limitPct', 'onPlan'])
        && plan.answers is map
        && plan.answers.keys().hasOnly(['trend', 'zone', 'signal', 'volume', 'plan'])
        && plan.answers.trend in ['yes', 'no', null]
        && plan.answers.zone in ['yes', 'no', null]
        && plan.answers.signal in ['yes', 'no', null]
        && plan.answers.volume in ['yes', 'no', null]
        && plan.answers.plan in ['yes', 'no', null]
        && (plan.eventsOk == null || plan.eventsOk is bool)
        && (plan.r == null || (plan.r is number && plan.r >= -100 && plan.r <= 100))
        && (plan.riskPct == null || (plan.riskPct is number && plan.riskPct >= 0 && plan.riskPct <= 100))
        && plan.limitPct is number
        && plan.limitPct >= 0.05
        && plan.limitPct <= 100
        && plan.onPlan is bool;
    }

    function isValidPaperJournal(data) {
      return data.journal is string
        && data.journal.size() <= 1000
        && data.researchNoteId is string
        && data.researchNoteId.size() <= 64;
    }

    function isValidPaperPosition(data) {
      return data.keys().hasAll(['userId', 'sessionId', 'instrumentId', 'side', 'contracts', 'entryPrice', 'stopLoss', 'takeProfit', 'marginPerContractUsd', 'entryFeeVnd', 'entryFxRate', 'journal', 'researchNoteId', 'openedAt'])
        && data.keys().hasOnly(['userId', 'sessionId', 'instrumentId', 'side', 'contracts', 'entryPrice', 'stopLoss', 'takeProfit', 'marginPerContractUsd', 'entryFeeVnd', 'entryFxRate', 'journal', 'researchNoteId', 'openedAt', 'plan'])
        && data.userId is string
        && data.userId == request.auth.uid
        && data.sessionId is string
        && data.instrumentId is string
        && data.instrumentId.size() >= 1
        && data.instrumentId.size() <= 32
        && data.side in ['LONG', 'SHORT']
        && data.contracts is int
        && data.contracts >= 1
        && data.contracts <= 1000
        && isValidPaperPrice(data.entryPrice)
        && isValidPaperStop(data.stopLoss)
        && isValidPaperStop(data.takeProfit)
        && data.marginPerContractUsd is number
        && data.marginPerContractUsd >= 0
        && data.marginPerContractUsd <= 100000000
        && data.entryFeeVnd is number
        && data.entryFeeVnd >= 0
        && data.entryFeeVnd <= 1000000000000
        && data.entryFxRate is number
        && data.entryFxRate > 0
        && data.entryFxRate <= 1000000
        && isValidPaperJournal(data)
        && data.openedAt is timestamp
        && (!('plan' in data) || isValidPaperPlan(data.plan));
    }

    function isValidPaperOrder(data) {
      return data.keys().hasAll(['userId', 'sessionId', 'instrumentId', 'side', 'contracts', 'entryPrice', 'exitPrice', 'stopLoss', 'takeProfit', 'closeReason', 'grossPnlUsd', 'feesVnd', 'pnlUsd', 'pnlVnd', 'rMultiple', 'fxRate', 'journal', 'researchNoteId', 'openedAt', 'closedAt'])
        && data.keys().hasOnly(['userId', 'sessionId', 'instrumentId', 'side', 'contracts', 'entryPrice', 'exitPrice', 'stopLoss', 'takeProfit', 'closeReason', 'grossPnlUsd', 'feesVnd', 'pnlUsd', 'pnlVnd', 'rMultiple', 'fxRate', 'journal', 'researchNoteId', 'openedAt', 'closedAt', 'plan'])
        && data.userId is string
        && data.userId == request.auth.uid
        && data.sessionId is string
        && data.instrumentId is string
        && data.instrumentId.size() >= 1
        && data.instrumentId.size() <= 32
        && data.side in ['LONG', 'SHORT']
        && data.contracts is int
        && data.contracts >= 1
        && data.contracts <= 1000
        && isValidPaperPrice(data.entryPrice)
        && isValidPaperPrice(data.exitPrice)
        && isValidPaperStop(data.stopLoss)
        && isValidPaperStop(data.takeProfit)
        && data.closeReason in ['MANUAL', 'STOP_LOSS', 'TAKE_PROFIT', 'STOP_OUT']
        && data.grossPnlUsd is number
        && data.feesVnd is number
        && data.feesVnd >= 0
        && data.pnlUsd is number
        && data.pnlVnd is number
        && (data.rMultiple == null || data.rMultiple is number)
        && data.fxRate is number
        && data.fxRate > 0
        && data.fxRate <= 1000000
        && isValidPaperJournal(data)
        && data.openedAt is timestamp
        && data.closedAt is timestamp
        && (!('plan' in data) || isValidPaperPlan(data.plan));
    }

    // Users collection (PII isolated to verified owner only; list completely disabled)
    match /users/{userId} {
      allow get: if isValidId(userId) && isVerifiedOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId)
        && isVerifiedOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isVerifiedOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'updatedAt']);
      allow delete: if false;
    }

    // UserSettings collection
    match /userSettings/{userId} {
      allow get: if isValidId(userId) && isVerifiedOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId)
        && isVerifiedOwner(userId)
        && isValidUserSettings(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isVerifiedOwner(userId)
        && isValidUserSettings(incoming(), userId)
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly([
            'accountEquity',
            'accountCurrency',
            'riskPercentagePerTrade',
            'dailyLossLimitPct',
            'maxOpenPositions',
            'maxPortfolioRiskPct',
            'maxContractsPerInstrument',
            'updatedAt'
          ]) ||
          incoming().diff(existing()).affectedKeys().hasOnly([
            'defaultTradingStyle',
            'defaultTimeframe',
            'displayTimezone',
            'updatedAt'
          ]) ||
          incoming().diff(existing()).affectedKeys().hasOnly([
            'accountEquity',
            'accountCurrency',
            'riskPercentagePerTrade',
            'dailyLossLimitPct',
            'maxOpenPositions',
            'maxPortfolioRiskPct',
            'maxContractsPerInstrument',
            'defaultTradingStyle',
            'defaultTimeframe',
            'displayTimezone',
            'updatedAt'
          ])
        );
      allow delete: if false;
    }

    // Manual portfolio positions (owner-isolated; terminal state locking when CLOSED)
    match /positions/{positionId} {
      allow get: if isValidId(positionId) && isVerifiedUser() && existing().userId == request.auth.uid;
      allow list: if isVerifiedUser() && resource.data.userId == request.auth.uid;
      allow create: if isValidId(positionId)
        && isVerifiedUser()
        && isValidPortfolioPosition(incoming())
        && incoming().status == 'OPEN'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(positionId)
        && isVerifiedUser()
        && isValidPortfolioPosition(incoming())
        && existing().userId == request.auth.uid
        && existing().status != 'CLOSED'
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['stopLoss', 'takeProfit', 'notes', 'updatedAt']) ||
          (incoming().status == 'CLOSED' && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'notes', 'updatedAt']))
        );
      allow delete: if isValidId(positionId) && isVerifiedUser() && existing().userId == request.auth.uid;
    }

    // Private trade journal entries (owner-isolated; terminal state locking when CLOSED)
    match /tradeJournal/{entryId} {
      allow get: if isValidId(entryId) && isVerifiedUser() && existing().userId == request.auth.uid;
      allow list: if isVerifiedUser() && resource.data.userId == request.auth.uid;
      allow create: if isValidId(entryId)
        && isVerifiedUser()
        && isValidTradeJournalEntry(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(entryId)
        && isVerifiedUser()
        && isValidTradeJournalEntry(incoming())
        && existing().userId == request.auth.uid
        && existing().status != 'CLOSED'
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['notes', 'rationale', 'stopLoss', 'takeProfit', 'updatedAt']) ||
          (incoming().status == 'CLOSED' && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'exitTimestamp', 'exitPrice', 'realizedPnl', 'tradingCosts', 'resultInR', 'notes', 'updatedAt']))
        );
      allow delete: if isValidId(entryId) && isVerifiedUser() && existing().userId == request.auth.uid;
    }

    // Research Notebook notes (T18): private to the verified owner; userId/createdAt immutable.
    match /researchNotes/{noteId} {
      allow get: if isValidId(noteId) && isVerifiedUser() && existing().userId == request.auth.uid;
      allow list: if isVerifiedUser() && resource.data.userId == request.auth.uid;
      allow create: if isValidId(noteId)
        && isVerifiedUser()
        && isValidResearchNote(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(noteId)
        && isVerifiedUser()
        && isValidResearchNote(incoming())
        && existing().userId == request.auth.uid
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['instrumentId', 'title', 'body', 'tags', 'chartContext', 'updatedAt']);
      allow delete: if isValidId(noteId) && isVerifiedUser() && existing().userId == request.auth.uid;
    }

    // Paper trading (T58): virtual money only, private to the verified owner.
    // Practice sessions: userId/createdAt immutable; a closed session can only be renamed.
    match /paperSessions/{sessionId} {
      allow get: if isValidId(sessionId) && isVerifiedUser() && existing().userId == request.auth.uid;
      allow list: if isVerifiedUser() && resource.data.userId == request.auth.uid;
      allow create: if isValidId(sessionId)
        && isVerifiedUser()
        && isValidPaperSession(incoming())
        && incoming().createdAt <= request.time
        && incoming().updatedAt == request.time
        && (incoming().closedAt == null || incoming().closedAt <= request.time);
      allow update: if isValidId(sessionId)
        && isVerifiedUser()
        && isValidPaperSession(incoming())
        && existing().userId == request.auth.uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'startingCapitalVnd', 'balanceVnd', 'settings', 'status', 'closedAt', 'finalEquityVnd', 'updatedAt'])
        && (existing().status == 'active'
          ? (incoming().status == 'active' || incoming().closedAt == request.time)
          : incoming().diff(existing()).affectedKeys().hasOnly(['name', 'updatedAt']));
      allow delete: if isValidId(sessionId) && isVerifiedUser() && existing().userId == request.auth.uid;
    }

    // Open paper positions (only in an active session): immutable except stop/target levels and the journal note.
    match /paperPositions/{positionId} {
      allow get: if isValidId(positionId) && isVerifiedUser() && existing().userId == request.auth.uid;
      allow list: if isVerifiedUser() && resource.data.userId == request.auth.uid;
      allow create: if isValidId(positionId)
        && isVerifiedUser()
        && isValidPaperPosition(incoming())
        && ownsPaperSession(incoming().sessionId)
        && paperSessionAfter(incoming().sessionId).status == 'active'
        && incoming().openedAt <= request.time;
      allow update: if isValidId(positionId)
        && isVerifiedUser()
        && isValidPaperPosition(incoming())
        && existing().userId == request.auth.uid
        && incoming().diff(existing()).affectedKeys().hasOnly(['stopLoss', 'takeProfit', 'journal', 'researchNoteId']);
      allow delete: if isValidId(positionId) && isVerifiedUser() && existing().userId == request.auth.uid;
    }

    // Closed paper trades (order history): write-once, only the journal note may change afterwards.
    match /paperOrders/{orderId} {
      allow get: if isValidId(orderId) && isVerifiedUser() && existing().userId == request.auth.uid;
      allow list: if isVerifiedUser() && resource.data.userId == request.auth.uid;
      allow create: if isValidId(orderId)
        && isVerifiedUser()
        && isValidPaperOrder(incoming())
        && ownsPaperSession(incoming().sessionId)
        && incoming().closedAt <= request.time
        && incoming().openedAt <= incoming().closedAt;
      allow update: if isValidId(orderId)
        && isVerifiedUser()
        && isValidPaperOrder(incoming())
        && existing().userId == request.auth.uid
        && incoming().diff(existing()).affectedKeys().hasOnly(['journal', 'researchNoteId']);
      allow delete: if isValidId(orderId) && isVerifiedUser() && existing().userId == request.auth.uid;
    }

    // Append-only AuditLogs collection
    match /auditLogs/{logId} {
      allow get: if isValidId(logId) && isVerifiedUser() && existing().userId == request.auth.uid;
      allow list: if isVerifiedUser() && resource.data.userId == request.auth.uid;
      allow create: if isValidId(logId)
        && isVerifiedUser()
        && isValidAuditLog(incoming())
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if false;
    }
  }
}
